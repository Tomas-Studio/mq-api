# Copy to .env.local (Bun loads it automatically; it is gitignored).

# Server (apps/server)
PORT=8080

# Identity: HMAC key for stored sign-in codes. At least 32 random bytes; from Key Vault when deployed.
IDENTITY_CODE_SECRET=<random secret>
# Email transport. Only "log" exists so far (development: sign-in codes go to the log).
MAIL_TRANSPORT=log

# Runtime database as mq_app on Neon's pooled endpoint (ADR-0025)
DATABASE_URL=postgres://mq_app:<password>@<endpoint>-pooler.<region>.azure.neon.tech/mqapi?sslmode=verify-full
# Cross-tenant SystemSql as mq_system (ADR-0013)
DATABASE_SYSTEM_URL=postgres://mq_system:<password>@<endpoint>-pooler.<region>.azure.neon.tech/mqapi?sslmode=verify-full
# Migrations as mq_migrator over a direct connection
DATABASE_MIGRATOR_URL=postgres://mq_migrator:<password>@<endpoint>.<region>.azure.neon.tech/mqapi?sslmode=verify-full

# Integration tests: admin connection to a DISPOSABLE Postgres 16+ server.
# The harness creates and drops databases and sets passwords on the mq_* roles.
# Leave unset to have Testcontainers start one (needs Docker).
TEST_DATABASE_URL=postgres://postgres:<password>@localhost:5432/postgres
