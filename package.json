{
  "name": "mq-api",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "tsc -b tsconfig.json",
    "lint": "oxlint && dprint check",
    "format": "oxlint --fix && dprint fmt",
    "test": "bun run --bun vitest run",
    "test:watch": "bun run --bun vitest",
    "dev": "bun --watch apps/server/src/Main.ts",
    "db:migrate": "bun packages/db/src/bin/migrate.ts",
    "db:seed": "bun packages/db/src/bin/seed.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "dprint": "0.65.0",
    "oxlint": "1.95.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
